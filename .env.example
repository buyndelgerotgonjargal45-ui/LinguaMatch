# ─── LinguaMatch environment ──────────────────────────────────────────────
# Local development: copy to .env (cp .env.example .env). One file serves both
# apps: the server reads ../.env, and next.config.ts loads it for the web app.
# Production: server variables go in Render, web variables in Vercel (see README).

# --- Server (Render) ------------------------------------------------------
NODE_ENV=development
# Render sets PORT itself; don't set it there.
PORT=4000
# Exact origin(s) of the web app allowed to call the API and open sockets,
# comma-separated, no trailing slash. http://localhost:3000 is always allowed
# outside production. Production: https://linguamatch.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# MongoDB connection string, e.g. mongodb://localhost:27017/linguamatch
# or a MongoDB Atlas URI. Leave empty and set USE_IN_MEMORY_DB=true to run
# an ephemeral database for local development (data is lost on restart).
MONGODB_URI=
USE_IN_MEMORY_DB=true

# Secret that signs access and refresh tokens (at least 32 characters). The
# server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Access token: kept in browser memory, sent as a Bearer header and in the socket handshake.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token: httpOnly cookie, extended on every refresh.
REFRESH_TOKEN_TTL_DAYS=30

# --- AI -------------------------------------------------------------------
# The AI layer is provider-agnostic (server/src/services/ai). Only "anthropic"
# is implemented today. Without a key, the app runs but topics, assessment and
# feedback clearly report that AI is unavailable — nothing is faked.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- WebRTC ---------------------------------------------------------------
# Public STUN servers work for most home networks. Users behind strict/corporate
# NATs need a TURN relay (e.g. coturn, Twilio, Cloudflare Calls).
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Matchmaking ----------------------------------------------------------
# Max CEFR distance ever allowed (1 = B1 can meet A2/B2). Exact level is always tried first.
MATCH_MAX_LEVEL_DISTANCE=1
# Seconds of waiting before the acceptable level range widens by one step.
MATCH_EXPAND_AFTER_SECONDS=10
# How many recent partners to avoid re-matching with.
MATCH_RECENT_PARTNER_WINDOW=3

# --- Moderation -----------------------------------------------------------
# Distinct reporters within 24h that trigger an automatic 24h suspension.
MODERATION_AUTO_SUSPEND_REPORTS=3

# --- Web (Vercel) ---------------------------------------------------------
# Both point at the API. In production that's the Render URL, e.g.
# https://linguamatch-api.onrender.com, and a Vercel build fails if either is missing.
# Where the browser opens the Socket.IO connection (baked in at build time).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Where Next.js proxies /api/* so REST calls and the refresh cookie stay same-origin.
API_URL=http://localhost:4000
