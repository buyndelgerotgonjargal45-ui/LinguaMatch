# ─── LinguaMatch environment ──────────────────────────────────────────────
# Copy to .env (cp .env.example .env). The server reads ../.env; the web app
# reads the NEXT_PUBLIC_* values below at build/dev time.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Origin of the Next.js app (CORS + Socket.IO)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB connection string, e.g. mongodb://localhost:27017/linguamatch
# or a MongoDB Atlas URI. Leave empty and set USE_IN_MEMORY_DB=true to run
# an ephemeral database for local development (data is lost on restart).
MONGODB_URI=
USE_IN_MEMORY_DB=true

# Long random string used to sign session tokens:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_DAYS=7

# --- AI -------------------------------------------------------------------
# The AI layer is provider-agnostic (server/src/services/ai). Only "anthropic"
# is implemented today. Without a key, the app runs but topics, assessment and
# feedback clearly report that AI is unavailable — nothing is faked.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- WebRTC ---------------------------------------------------------------
# Public STUN servers work for most home networks. Users behind strict/corporate
# NATs need a TURN relay (e.g. coturn, Twilio, Cloudflare Calls).
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Matchmaking ----------------------------------------------------------
# Max CEFR distance ever allowed (1 = B1 can meet A2/B2). Exact level is always tried first.
MATCH_MAX_LEVEL_DISTANCE=1
# Seconds of waiting before the acceptable level range widens by one step.
MATCH_EXPAND_AFTER_SECONDS=10
# How many recent partners to avoid re-matching with.
MATCH_RECENT_PARTNER_WINDOW=3

# --- Moderation -----------------------------------------------------------
# Distinct reporters within 24h that trigger an automatic 24h suspension.
MODERATION_AUTO_SUSPEND_REPORTS=3

# --- Web (Next.js) --------------------------------------------------------
# Where the browser connects for Socket.IO. REST calls are proxied by Next.js.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Server-side only: where Next.js proxies /api/* requests.
API_URL=http://localhost:4000
